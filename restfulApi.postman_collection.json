              "});",
              "",
              "pm.test(\"Response body contains error message\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"error\");",
              "});",
              "",
              "pm.test(\"Error message indicates object was not found or array is empty\", function () {",
              "    const jsonData = pm.response.json();",
              "    const errorMessage = jsonData.error.toLowerCase();",
              "    pm.expect(errorMessage).to.satisfy(function (msg) {",
              "        return msg.includes(\"not found\") ||",
              "               msg.includes(\"object with the requested id\") ||",
              "               msg.includes(\"empty\") ||",
              "               msg.includes(\"no objects\");",
              "    }, \"Expected error message to indicate the object was not found or the collection is empty\");",
              "});"
