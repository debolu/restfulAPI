    {
      "name": "Add a new product with an empty compulsory field.",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 400', function () {",
              "    pm.response.to.have.status(400);",
              "})",
              "",
              "pm.test('Response body contains error message', function () {",
              "    const jsonData = pm.response.json();",
              "        // 1. Check if all top-level fields exist and have data",
              "    pm.expect(jsonData.id, \"id should not be empty\").to.exist.and.not.be.empty;",
              "    pm.expect(jsonData.name, \"name should not be empty\").to.exist.and.not.be.empty;",
              "    pm.expect(jsonData.data, \"data object should exist\").to.exist;",
              "    ",
              "    // 2. Check that no field in the data object is empty",
              "    Object.keys(jsonData.data).forEach(function (key) {",
              "        pm.expect(jsonData.data[key], `${key} should not be empty`).to.exist.and.not.be.empty;",
              "    });",
              "",
              "    // 3. Validate year type (must be integer)",
              "    pm.expect(jsonData.data.year, \"year should be a number\").to.be.a(\"number\");",
              "    pm.expect(Number.isInteger(jsonData.data.year), \"year must be an integer\").to.be.true;",
              "",
              "    // 4. Validate price type (must be a number, can be decimal)",
              "    pm.expect(jsonData.data.price, \"price should be a number\").to.be.a(\"number\");",
              "",
              "})"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
