    {
      "name": "Authenticated resource with an invalid API key",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 401 or 403', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([",
              "        401,",
              "        403",
              "    ]);",
              "})",
              "",
              "pm.test('Response body contains error message', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('error');",
              "    // pm.expect(jsonData.error).to.eql('API key is missing');",
              "",
              "        // Normalize case for easier matching",
              "    let msg = jsonData.error.toLowerCase();",
              "",
              "    // Check for required words",
              "    let hasAPI = msg.includes(\"api\");",
              "    let hasKey = msg.includes(\"key\");",
              "    let hasInvalidPhrase = msg.includes(\"not valid\") || msg.includes(\"invalid\");",
              "",
              "    pm.expect(hasAPI, \"Message should contain 'API'\").to.be.true;",
              "    pm.expect(hasKey, \"Message should contain 'Key'\").to.be.true;",
              "    pm.expect(hasInvalidPhrase, \"Message should contain 'not valid' or 'Invalid'\").to.be.true;",
              "})"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
