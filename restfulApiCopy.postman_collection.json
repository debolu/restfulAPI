    {
      "name": "Add a new product with a field having the wrong character type.",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const Ajv = require('ajv');",
              "const ajv = new Ajv({ allErrors: true });",
              "",
              "pm.test(\"Validate response against reusable schema\", function () {",
              "    let jsonData = pm.response.json();",
              "",
              "    // Load schema from collection/environment variable",
              "\t\tconst schema = {",
              "  \"responseSchema\": {",
              "    \"type\": \"object\",",
              "    \"required\": [\"id\", \"name\", \"data\"],",
              "    \"properties\": {",
              "      \"id\": { \"type\": \"string\", \"minLength\": 1 },",
              "      \"name\": { \"type\": \"string\", \"minLength\": 1 },",
              "      \"data\": {",
              "        \"type\": \"object\",",
              "        \"required\": [\"year\", \"price\", \"CPU model\", \"Hard disk size\", \"Case Size\", \"Screen size\", \"generation\"],",
              "        \"properties\": {",
              "          \"year\": { \"type\": \"integer\" },",
              "          \"price\": { \"type\": \"integer\" },",
              "          \"CPU model\": { \"type\": \"string\", \"minLength\": 1 },",
              "          \"Hard disk size\": { \"type\": \"string\", \"pattern\": \"^\\\\d+(\\\\s)?TB$\" },",
              "          \"Case Size\": { \"type\": \"string\", \"pattern\": \"^\\\\d+mm$\" },",
              "          \"Screen size\": { \"type\": \"number\" },",
              "          \"generation\": { \"type\": \"string\", \"pattern\": \"^\\\\d+(st|nd|rd|th)$\" }",
              "        },",
              "        \"additionalProperties\": false",
              "      }",
              "    },",
              "    \"additionalProperties\": false",
              "  }",
              "}",
              "    const parsedSchema = typeof schema === \"string\" ? JSON.parse(schema) : schema;",
              "",
              "    // Validate",
              "    const validate = ajv.compile(parsedSchema);",
              "    const valid = validate(jsonData);",
              "",
              "    pm.expect(valid, \"Response should match schema\").to.be.true;",
              "",
              "    if (!valid) {",
              "        console.log(\"Schema validation errors:\", validate.errors);",
              "        validate.errors.forEach(err => {",
              "            pm.expect.fail(`Field validation error: ${err.instancePath} ${err.message}`);",
              "        });",
              "    }",
              "});",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
